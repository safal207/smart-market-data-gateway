SMDG_ENVIRONMENT=development
SMDG_LOG_LEVEL=INFO
SMDG_REDIS_URL=redis://localhost:6379/0
SMDG_DATABASE_URL=postgresql://smdg:smdg-local-only@localhost:5432/smdg
SMDG_COLLECTOR_METRICS_PORT=9101
SMDG_CANDLE_ARCHIVE_METRICS_PORT=9102

# Replace in non-development environments.
SMDG_JWT_SECRET=replace-with-a-secret-from-your-secret-manager
SMDG_JWT_ALGORITHM=HS256
SMDG_JWT_ISSUER=smart-market-data-gateway
SMDG_JWT_AUDIENCE=market-data-clients
SMDG_JWT_JWKS_URL=
SMDG_ALLOW_DEV_TOKENS=true
SMDG_ALLOW_ANONYMOUS_DEV=true

# Optional client-profile / entitlement service.
SMDG_CLIENT_PROFILE_URL=
SMDG_CLIENT_PROFILE_SERVICE_TOKEN=

SMDG_QUOTE_FRESHNESS_SECONDS=5
SMDG_CANDLE_HISTORY_RETENTION_SECONDS=2592000
SMDG_CANDLE_UPDATE_RETRY_LIMIT=8

# Durable one-minute archive. The API keeps working from Redis if the database is unavailable.
SMDG_CANDLE_ARCHIVE_ENABLED=true
SMDG_CANDLE_ARCHIVE_RETENTION_SECONDS=157680000
SMDG_CANDLE_ARCHIVE_POOL_MAX_SIZE=4
SMDG_CANDLE_ARCHIVE_GROUP=smdg:candle-archive-writers:v1
SMDG_CANDLE_ARCHIVE_CLAIM_IDLE_MS=30000
SMDG_CANDLE_ARCHIVE_METRICS_INTERVAL_SECONDS=5
SMDG_STREAM_MAXLEN=1000000

SMDG_SUBSCRIPTION_GRACE_SECONDS=3
SMDG_SUBSCRIPTION_TTL_SECONDS=60
SMDG_HEARTBEAT_SECONDS=15
SMDG_CLIENT_IDLE_TIMEOUT_SECONDS=45
SMDG_WEBSOCKET_QUEUE_SIZE=512
SMDG_COALESCING_WARNING_THRESHOLD=100
SMDG_USAGE_QUEUE_SIZE=10000

SMDG_MOCK_SYMBOLS=AAPL,TSLA,NVDA,MSFT,GOOG
SMDG_MOCK_INTERVAL_SECONDS=0.1
SMDG_MOCK_DUPLICATE_EVERY=
SMDG_MOCK_FAIL_AFTER_EVENTS=
